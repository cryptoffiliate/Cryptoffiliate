# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Cron security ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET=generate-a-random-secret-here

# ── Site config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cryptoffiliate.com
NEXT_PUBLIC_SITE_NAME=Cryptoffiliate

# ── Exchange API keys (OPTIONAL — upgrades fee fetching from fallback to live) ─
# OKX — create at https://www.okx.com/account/my-api (Read permission only)
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# Coinbase Advanced Trade — https://www.coinbase.com/settings/api (View only)
COINBASE_API_KEY=

# ── Analytics (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Resend (email) ────────────────────────────────────────────────────────────
# Get your key at https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Create an Audience in Resend dashboard, paste the ID here
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Domain verified in Resend (must match cryptoffiliate.com DNS)
RESEND_FROM_DOMAIN=cryptoffiliate.com

# ── Admin secret (send-bonus-alert endpoint) ──────────────────────────────────
# Generate with: openssl rand -base64 32
ADMIN_SECRET=generate-a-random-secret-here
